<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.Nuclei</RootNamespace>
    <AssemblyName>Tamp.Nuclei</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Tamp.Nuclei</PackageId>
    <Description>Tamp CommandPlan wrappers for the Nuclei vulnerability scanner (MIT, ProjectDiscovery). Template-driven scanning plus DAST/fuzzing templates and OpenAPI/Swagger input, with native SARIF export for the Tamp security pipeline. Single static Go binary — no runtime dependencies. Typed severity and input-mode enums, Secret-aware header handling, and secret-file support for authenticated scans.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TampCorePath)" Condition="'$(TampCoreMode)' == 'project'" />
    <PackageReference Include="Tamp.Core" Condition="'$(TampCoreMode)' == 'package'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
